{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pokemon Den",
  "version": "2.3.0",
  "identifier": "com.darkhearts.pokemonchest",
  "build": {
    "frontendDist": "../tauri-shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pokémon Den",
        "label": "main",
        "width": 1340,
        "height": 880,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0e16"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Lifestyle",
    "copyright": "© 2026 DarkHearts",
    "shortDescription": "Your Pokémon card collection — live comps, sell & grade intelligence.",
    "longDescription": "Pokémon Den turns your PriceCharting collection export into a premium local database: every card with real art (English + Japanese), portfolio value and P/L, one-click live sold comps on eBay/TCGplayer/Mercari, a grading break-even advisor, and optional bring-your-own-key live data and AI recommendations. 100% local and private. Unofficial fan-made tool: Pokémon © Nintendo / Creatures Inc. / GAME FREAK inc.; Pokémon and character names are trademarks of Nintendo. Not affiliated with, endorsed, or sponsored by Nintendo or The Pokémon Company.",
    "resources": {
      "../server.py": "app/server.py",
      "../index.html": "app/index.html",
      "../assets/": "app/assets/",
      "../data/": "app/data/",
      "../scripts/": "app/scripts/",
      "../LEGAL.md": "app/LEGAL.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": "Apple Development: Brandon Barkey (LFQPLFRKD2)",
      "providerShortName": null,
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": { "width": 660, "height": 420 },
        "appPosition": { "x": 180, "y": 220 },
        "applicationFolderPosition": { "x": 480, "y": 220 }
      }
    },
    "iOS": {
      "minimumSystemVersion": "14.0",
      "developmentTeam": "WYUV6QMULK"
    }
  }
}
