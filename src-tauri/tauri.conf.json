{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pokémon DenZ",
  "version": "2.5.0",
  "identifier": "com.darkhearts.pokemonchest",
  "build": {
    "frontendDist": "../tauri-shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pok\u00e9mon Chest",
        "label": "main",
        "width": 1340,
        "height": 880,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0e16"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Lifestyle",
    "copyright": "\u00a9 2026 DarkHearts",
    "shortDescription": "Your card vault \u2014 one-time, on your Mac. Sell, grade, buy, scan.",
    "longDescription": "Pok\u00e9mon Chest is a private collection vault you own: open Today for clear next steps (sell, grade, buy, refresh, scan), fee-aware listings, grading math, and a full TCGdex scanner. Runs locally with no account and no subscription. Optional bring-your-own-key live data. \u00a9 2026 DarkHearts",
    "resources": {
      "../server.py": "app/server.py",
      "../index.html": "app/index.html",
      "../assets/": "app/assets/",
      "../data/": "app/data/",
      "../scripts/": "app/scripts/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": "Apple Development: Brandon Barkey (LFQPLFRKD2)",
      "providerShortName": null
    },
    "iOS": {
      "minimumSystemVersion": "14.0",
      "developmentTeam": "WYUV6QMULK"
    }
  }
}
